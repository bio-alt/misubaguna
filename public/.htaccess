<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One canonical host: send www.misubaguna.com to https://misubaguna.com
    RewriteCond %{HTTP_HOST} ^www\.misubaguna\.com$ [NC]
    RewriteRule ^ https://misubaguna.com%{REQUEST_URI} [L,R=301]

    # Catalog PDF withdrawn while the catalog is updated (config/catalog.php 'paused'):
    # send old download links to the /catalog/ notice. Remove this rule to restore it.
    RewriteRule ^wp-content/uploads/2023/11/Misuba-Guna-Indonesia-Company-Profile_Interactive\.pdf$ https://%{HTTP_HOST}/catalog/ [R=302,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
